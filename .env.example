# ==============================================================================
# Google Cloud Agent Platform - Environment Configuration
# ==============================================================================

# GCP Project & Region Settings
GCP_PROJECT_ID=agent-demo-09
GCP_REGION=us-central1
BIGQUERY_DATASET=marketing_analytics

# API Key for Gemini Models (if using Google AI Studio / Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Armor Security Floor ID
MODEL_ARMOR_FLOOR_ID=projects/agent-demo-09/locations/us-central1/floors/marketing-floor

# Execution Mode: Set to 'true' to connect to live GCP services, or 'false' for local mock fallback
USE_GCP_CLOUD=false

# Server Port
PORT=8080
